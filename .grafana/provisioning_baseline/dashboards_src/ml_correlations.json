        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^col_j$",
            "renamePattern": "X"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^correlation$",
            "renamePattern": "Value"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {}
        },
        "overrides": []
      }
