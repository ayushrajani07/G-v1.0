{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0" },
    { "type": "panel", "id": "graph", "name": "Graph", "version": "9.5.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" }
  ],
  "title": "G6 Streaming Metrics",
  "tags": ["g6", "streaming", "metrics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROM",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "index",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "query": "label_values(g6_drift_mae, index)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "horizon",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
        "query": "label_values(g6_drift_mae{index=\"$index\"}, horizon)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {"text": "All", "value": "$__all"}
      },
      {
        "name": "coverage_threshold",
        "type": "constant",
        "label": "Coverage Drift Threshold",
        "query": "1.5",
        "current": {"text": "1.5", "value": "1.5"},
        "hide": 0
      },
      {
        "name": "norm_threshold",
        "type": "constant",
        "label": "Norm Error Drift Threshold",
        "query": "1.4",
        "current": {"text": "1.4", "value": "1.4"},
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Norm Drift Breach",
        "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
        "enable": true,
        "expr": "g6_forecast_norm_error_drift_ratio{index=\"$index\",horizon=\"$horizon\"} > $norm_threshold",
        "iconColor": "red",
        "hide": false
      },
      {
        "name": "Coverage Drift Breach",
        "datasource": {"type": "prometheus", "uid": "${DS_PROM}"},
        "enable": true,
        "expr": "g6_forecast_coverage_drift_delta_pct{index=\"$index\",horizon=\"$horizon\"} > $coverage_threshold",
        "iconColor": "orange",
        "hide": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "Live MAE",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "g6_live_mae",
          "legendFormat": "MAE",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null"
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Live MAE Alerts (total)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "increase(g6_live_mae_alerts_total[15m])",
          "legendFormat": "Alerts (15m)",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current MAE",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 9 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "expr": "g6_live_mae", "refId": "A" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts (sum)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 9 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "expr": "g6_live_mae_alerts_total", "refId": "A" } ]
    }
    ,
    {
      "id": 50,
      "type": "row",
      "title": "Drift (Index: $index)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 },
      "repeat": "index",
      "collapsed": false
    },
    {
      "id": 5,
      "type": "graph",
        },
        {
          "expr": "vector($norm_threshold)",
          "legendFormat": "threshold $norm_threshold",
          "refId": "B"
      "title": "Drift MAE (windowed)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "g6_drift_mae{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "MAE {{index}} {{horizon}}",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null",
      "repeat": "horizon",
      "maxPerRow": 2
    },
    {
      "id": 6,
      "type": "graph",
      "title": "Drift MAPE (windowed)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "g6_drift_mape{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "MAPE {{index}} {{horizon}}",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null",
      "repeat": "horizon",
      "maxPerRow": 2
    },
    {
      "id": 8,
      "type": "graph",
      "title": "Norm Error Drift Ratio",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "g6_forecast_norm_error_drift_ratio{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "Norm Drift {{index}} {{horizon}}",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null",
      "repeat": "horizon",
      "maxPerRow": 2
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Drift Last Status",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 24 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "expr": "g6_drift_status{index=\"$index\",horizon=\"$horizon\"}", "refId": "A" } ],
      "repeat": "horizon",
      "maxPerRow": 3
    }
    {
      "id": 9,
      "type": "graph",
      "title": "Coverage Drift Δ (pct points)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "targets": [
        {
          "expr": "g6_forecast_coverage_drift_delta_pct{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "Coverage Δ {{index}} {{horizon}}",
          "refId": "A"
        },
        {
          "expr": "vector($coverage_threshold)",
          "legendFormat": "threshold $coverage_threshold",
          "refId": "B"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null",
      "repeat": "horizon",
      "maxPerRow": 2,
      "yaxes": [
        { "format": "percent", "logBase": 1, "show": true },
        { "format": "short", "logBase": 1, "show": false }
      ]
    {
      "id": 11,
      "type": "table",
      "title": "Top 10 Coverage Drift (Δ pct points)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 40 },
      "targets": [
        {
          "expr": "topk(10, g6_forecast_coverage_drift_delta_pct{index=~\"$index\",horizon=~\"$horizon\"})",
          "legendFormat": "Δ {{index}} {{horizon}}",
          "refId": "A"
        }
      ],
      "options": {"showHeader": true},
      "transformations": []
    }
    }
  ]
}
