  { "name": "expiry_tag", "type": "custom", "query": "auto,this_week,next_week,this_month,next_month", "label": "Expiry tag", "current": { "text": "auto", "value": "auto" }, "description": "Selects the live_csv dataset (week/month). Tip: auto is safe for normal use; to replay historical days, switch to the specific week/month that matches that date (e.g., this_week/next_week/this_month) and adjust Offset if needed. Use Quick links › Resolve live path to verify." },
    { "name": "horizon", "type": "custom", "query": "30,60,390", "label": "Horizon (min)", "current": { "text": "60", "value": "60" }, "description": "Forecast horizon for the ribbon and diagnostics (minutes ahead)." },
    { "name": "pf_mode", "type": "custom", "query": "auto,hybrid,retrieval", "label": "Forecaster mode", "current": { "text": "auto", "value": "auto" }, "description": "High-level algorithm choice. Auto picks the best; hybrid blends; retrieval forces NN retrieval." },
  { "name": "pf_window", "type": "custom", "query": "0,60,120,180,240,360,480,720", "label": "Window (min)", "current": { "text": "180", "value": "180" }, "description": "Intraday lookback window used for retrieval/feature context. Use 0 for Open→Now (since 09:15 IST)." },
  { "name": "pf_k", "type": "custom", "query": "10,15,20,25,30,40", "label": "Neighbors (k)", "current": { "text": "20", "value": "20" }, "description": "Number of similar historical samples for retrieval; higher=k smoother bands." },
    { "name": "pf_bucket", "type": "custom", "query": "60000,300000", "label": "Bucket (ms)", "current": { "text": "60000", "value": "60000" }, "description": "Time aggregation bucket for series (1m=60000, 5m=300000)." },
    { "name": "offset", "type": "custom", "query": "-200,-150,-100,-50,0,50,100,150,200", "label": "Offset", "current": { "text": "0", "value": "0" }, "description": "Variant offset for live_csv alignment within the expiry (advanced)." },
  { "name": "pf_align", "type": "custom", "query": "trailing,future,auto", "label": "Time align", "current": { "text": "future", "value": "future" }, "description": "Where to place the forecast: future keeps targets > now (default); trailing shifts the curve to end at now for visual comparison; auto behaves like future." },
    { "name": "calibrate", "type": "custom", "query": "true,false", "label": "Calibrate", "current": { "text": "true", "value": "true" }, "description": "Apply band_scale to quantiles so realized coverage matches target." },
  { "name": "profile", "type": "custom", "query": "optimized,base,since_open,wide_bands,retrieval_only,conservative,high_variance", "label": "Profile", "current": { "text": "optimized", "value": "optimized" }, "description": "Profile presets for mode/window/k/band behavior. since_open uses dynamic window; retrieval_only may force retrieval mode." },
  { "name": "date_str", "type": "textbox", "query": "", "label": "Date (YYYY-MM-DD)", "current": { "text": "", "value": "" }, "description": "Optional backfill date (ISO). Leave blank for today. For historical replay (e.g., 2025-11-04), also set Expiry tag to the matching week/month and ensure data exists for that day (Quick links › Resolve live path)." },
  { "name": "now_ms", "type": "textbox", "query": "", "label": "now_override_ms (epoch ms)", "current": { "text": "${__to}", "value": "${__to}" }, "description": "Override 'now' with epoch ms. Defaults to the dashboard time range end (${__to}). Tip: set time range then leave this as-is for quick replay; enter a specific epoch ms to pause anywhere within the day." }
