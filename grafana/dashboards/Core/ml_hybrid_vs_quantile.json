{
  "title": "Hybrid vs Quantile (TP)",
  "uid": "ml-hybrid-quantile",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Hybrid vs p50 vs Baseline",
      "id": 1,
      "targets": [
        {
          "expr": "g6_ml_hybrid_prediction{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "hybrid ($index,$horizon)",
          "refId": "A"
        },
        {
          "expr": "g6_ml_prediction_p50{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "p50 ($index,$horizon)",
          "refId": "B"
        },
        {
          "expr": "g6_ml_hybrid_baseline{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "baseline ($index,$horizon)",
          "refId": "C"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Residual Component",
      "id": 2,
      "targets": [
        {
          "expr": "g6_ml_hybrid_residual{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "residual",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    }
    ,
    {
      "type": "stat",
      "title": "Hybrid Improvement Ratio (Baseline RMSE / Hybrid RMSE)",
      "id": 3,
      "targets": [
        {
          "expr": "(avg_over_time(g6_ml_hybrid_baseline{index=\"$index\",horizon=\"$horizon\"}[30m]) - avg_over_time(g6_ml_hybrid_prediction{index=\"$index\",horizon=\"$horizon\"}[30m]))",
          "legendFormat": "not_used",
          "refId": "A",
          "hide": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 1.0 },
              { "color": "green", "value": 1.1 }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "calculateField",
          "options": {
            "mode": "reduceRow",
            "replaceFields": true,
            "reduce": { "reducer": "lastNotNull" },
            "calcs": [],
            "expression": "${__value.raw}"
          }
        }
      ],
      "description": "Improvement ratio sourced from diagnostics API not directly available in Prometheus; placeholder panel. Replace with datasource pulling /api/ml/diagnostics CSV using Infinity to compute ratio."
    }
    ,
    {
      "type": "table",
      "title": "Hybrid vs Baseline RMSE (Diagnostics Snapshot)",
      "id": 4,
      "pluginVersion": "",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
          "type": "csv",
          "source": "url",
          "format": "table",
          "url": "/api/ml/diagnostics?index=$index&horizon=$horizon&model=sk_hgb_residual&window_minutes=120",
          "parser": "backend",
          "url_options": { "method": "GET" },
          "filters": []
        }
      ],
      "options": {
        "showHeader": true
      },
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "improvement_ratio" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 1.0 },
                    { "color": "green", "value": 1.1 }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
    ,
    {
      "type": "table",
      "title": "Hybrid + Move Diagnostics (Snapshot)",
      "id": 5,
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
          "type": "csv",
          "source": "url",
          "format": "table",
          "url": "/api/ml/diagnostics?index=$index&horizon=$horizon&model=sk_hgb_residual&window_minutes=120&include_move_stats=true&move_prob_threshold=0.6",
          "parser": "backend",
          "url_options": { "method": "GET" },
          "filters": []
        }
      ],
      "options": { "showHeader": true },
      "transformations": [],
      "fieldConfig": {
        "defaults": { "unit": "none", "mappings": [] },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "improvement_ratio" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 1.0 },
                    { "color": "green", "value": 1.1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "avg_move_probability" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.6 },
                    { "color": "red", "value": 0.8 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "move_high_prob_share" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.3 },
                    { "color": "red", "value": 0.6 }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "index",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(g6_ml_prediction_p50, index)",
        "refresh": 2
      },
      {
        "name": "horizon",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(g6_ml_prediction_p50, horizon)",
        "refresh": 2
      }
    ]
  }
}