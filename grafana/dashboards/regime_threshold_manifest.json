{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "Infinity datasource (HTTP / JSON).",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "panel", "id": "table", "name": "Table" },
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.6.0" },
    { "type": "panel", "id": "heatmap", "name": "Heatmap" },
    { "type": "panel", "id": "timeseries", "name": "Time series" }
  ],
  "title": "Regime Drift Threshold Manifest",
  "uid": "regime-threshold-manifest",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {"type": "timeseries","title": "Horizons Used Trend","id": 6,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest_history?limit=100","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"fieldConfig": {"defaults": {"unit": "none"},"overrides": [{"matcher": {"id": "byName", "options": "horizons_used"},"properties": [{"id": "unit", "value": "none"}]}]},"options": {"legend": {"displayMode": "list"},"tooltip": {"mode": "single"}},"transformations": [{"id": "organize","options": {"indexByName": {},"renameByName": {"horizons_used": "horizons_used"},"excludeByName": {"thresholds": true}}}]},
    {"type": "stat","title": "Promotion Status","id": 1,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"maxDataPoints": 1,"options": {"reduceOptions": {"values": false,"calcs": ["last"],"fields": ""},"orientation": "auto","textMode": "value","colorMode": "value","graphMode": "none"},"fieldConfig": {"defaults": {"unit": "none"},"overrides": []},"transformations": [{"id": "filterFieldsByName","options": {"include": ["reason"]}}]},
    {"type": "stat","title": "Max Relative Shift (%)","id": 5,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1","parser": "backend","format": "table","transform": "json","root_selector": "relative_shifts","columns": []}],"options": {"reduceOptions": {"values": false,"calcs": ["max"],"fields": "relative_shift_pct"},"orientation": "auto","textMode": "value","colorMode": "value","graphMode": "none"},"fieldConfig": {"defaults": {"unit": "percent","thresholds": {"mode": "percentage","steps": [{"color": "green","value": null},{"color": "yellow","value": 5},{"color": "orange","value": 10},{"color": "red","value": 15}]}},"overrides": []},"transformations": [{"id": "filterFieldsByName","options": {"include": ["relative_shift_pct"]}}]},
    {"type": "table","title": "Relative Shifts (%)","id": 4,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1","parser": "backend","format": "table","transform": "json","root_selector": "relative_shifts","columns": []}],"options": {"showHeader": true},"fieldConfig": {"defaults": {"unit": "percent"},"overrides": [{"matcher": {"id": "byName", "options": "key"},"properties": [{"id": "unit", "value": "none"}]},{"matcher": {"id": "byName", "options": "violation"},"properties": [{"id": "custom.cellOptions", "value": {"type": "color-text"}}]},{"matcher": {"id": "byName", "options": "relative_shift_pct"},"properties": [{"id": "unit", "value": "percent"},{"id": "thresholds","value": {"mode": "percentage","steps": [{"color": "green","value": null},{"color": "yellow","value": 5},{"color": "orange","value": 10},{"color": "red","value": 15}]}},{"id": "custom.cellOptions","value": {"type": "gauge"}}]}]},"transformations": [{"id": "organize","options": {"indexByName": {},"renameByName": {"key": "metric","relative_shift_pct": "shift_%"}}}]},
    {"type": "table","title": "Current Thresholds","id": 2,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1","parser": "backend","format": "table","transform": "json","root_selector": "thresholds","columns": []}],"options": {"showHeader": true},"fieldConfig": {"defaults": {"unit": "none"},"overrides": []}},
    {"type": "table","title": "Stability & Percentiles","id": 3,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"transformations": [{"id": "organize","options": {"excludeByName": {"thresholds": true}}}],"options": {"showHeader": true},"fieldConfig": {"defaults": {"unit": "none"},"overrides": []}},
    {"type": "timeseries","title": "Canary Backtest Penalty Timeline","id": 7,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/autotune_canary_history?limit=200","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"fieldConfig": {"defaults": {"unit": "none"},"overrides": [{"matcher": {"id": "byName", "options": "canary.backtest_penalty"},"properties": [{"id": "unit", "value": "none"}]}]},"options": {"legend": {"displayMode": "table"},"tooltip": {"mode": "single"}},"transformations": [{"id": "organize","options": {"renameByName": {"canary.backtest_penalty": "backtest_penalty","ts": "ts"},"indexByName": {}}}]},
    {"type": "heatmap","title": "Per-Horizon Canary Warn Violation Heatmap","id": 8,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/autotune_canary_history?limit=200","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"fieldConfig": {"defaults": {"unit": "percent","thresholds": {"mode": "absolute","steps": [{"color": "green","value": 0},{"color": "yellow","value": 0.05},{"color": "orange","value": 0.10},{"color": "red","value": 0.15}]}},"overrides": []},"options": {"legend": {"show": true},"yBucketSize": 1},"transformations": [{"id": "extractFields","options": {"sourceField": "canary.per_horizon","format": "json"}},{"id": "labelsToFields","options": {"valueLabel": "warn_violation_rate"}}]},
    {"type": "table","title": "Metrics Compare (${index_pick}/${horizon_pick})","id": 9,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/metrics/compare?index=${index_pick}&horizon=${horizon_pick}&include_drift=1","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"options": {"showHeader": true},"fieldConfig": {"defaults": {"unit": "none"},"overrides": []},"transformations": [{"id": "organize","options": {"excludeByName": {"decay_params": false}}}]}
    ,
    {"type": "stat","title": "Manifest Chain Valid","id": 10,"datasource": "${DS_INFINITY}","maxDataPoints": 1,
     "targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest_chain","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],
     "options": {"reduceOptions": {"values": false, "calcs": ["last"], "fields": ""}, "orientation": "auto", "textMode": "value", "colorMode": "value", "graphMode": "none"},
     "fieldConfig": {"defaults": {"unit": "none"}, "overrides": [{"matcher": {"id": "byName", "options": "valid"}, "properties": [
       {"id": "mappings", "value": [
         {"type": 1, "options": {"match": "true", "result": {"text": "VALID", "color": "green"}}},
         {"type": 1, "options": {"match": "false", "result": {"text": "BROKEN", "color": "red"}}}
       ]}
     ]}]},
     "transformations": [{"id": "filterFieldsByName","options": {"include": ["valid"]}}],
     "gridPos": {"h": 4, "w": 6, "x": 0, "y": 22}
    },
    {"type": "table","title": "Manifest Chain (Head → Tail)","id": 11,"datasource": "${DS_INFINITY}",
     "targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/threshold_manifest_chain","parser": "backend","format": "table","transform": "json","root_selector": "chain","columns": []}],
     "options": {"showHeader": true},
     "fieldConfig": {"defaults": {"unit": "none"}, "overrides": [{"matcher": {"id": "byName", "options": "signature_ok"}, "properties": [
       {"id": "custom.cellOptions", "value": {"type": "color-text"}},
       {"id": "mappings", "value": [
         {"type": 1, "options": {"match": "true", "result": {"text": "OK", "color": "green"}}},
         {"type": 1, "options": {"match": "false", "result": {"text": "BAD", "color": "red"}}}
       ]}
     ]}]},
     "transformations": [{"id": "organize","options": {"renameByName": {"file": "file", "signature_ok": "signature"}}}],
     "gridPos": {"h": 8, "w": 24, "x": 0, "y": 26}
    }
    ,
    {"type": "timeseries","title": "Canary Percentile Trend","id": 10,"datasource": "${DS_INFINITY}","targets": [{"datasource": "${DS_INFINITY}","type": "json","url": "/api/ml/ensemble/regime/autotune_canary_history?limit=300","parser": "backend","format": "table","transform": "json","root_selector": "$","columns": []}],"fieldConfig": {"defaults": {"unit": "percent","custom": {"drawStyle": "line","lineWidth": 2,"showPoints": "never","spanNulls": true}},"overrides": [{"matcher": {"id": "byName","options": "canary.warn_pctl"},"properties": [{"id": "displayName","value": "canary_warn"}]},{"matcher": {"id": "byName","options": "canary.crit_pctl"},"properties": [{"id": "displayName","value": "canary_crit"}]}]},"options": {"legend": {"displayMode": "table","placement": "bottom"},"tooltip": {"mode": "multi"}},"transformations": [{"id": "organize","options": {"renameByName": {"canary.warn_pctl": "canary.warn_pctl","canary.crit_pctl": "canary.crit_pctl","ts": "ts"},"indexByName": {}}},{"id": "filterFieldsByName","options": {"include": ["ts","canary.warn_pctl","canary.crit_pctl"]}}]}
  ],
  "templating": { "list": [
    {"name": "index_pick","label": "Index","type": "textbox","query": "NIFTY","current": {"text": "NIFTY","value": "NIFTY"}},
    {"name": "horizon_pick","label": "Horizon (min)","type": "textbox","query": "60","current": {"text": "60","value": "60"}}
  ] },
  "annotations": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"] }
}
