{
  "__inputs": [
    {"name": "DS_INFINITY", "label": "Infinity", "type": "datasource", "pluginId": "yesoreyeram-infinity-datasource", "pluginName": "Infinity"}
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0"},
    {"type": "panel", "id": "table", "name": "Table"},
    {"type": "panel", "id": "timeseries", "name": "Time series"},
    {"type": "panel", "id": "state-timeline", "name": "State timeline"},
    {"type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.6.0"}
  ],
  "title": "Feature Distribution Shift (PSI / KS)",
  "uid": "feature-shift",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "1m",
  "timezone": "browser",
  "templating": {"list": [
    {"name": "G6_API_BASE", "label": "API Base", "type": "textbox", "query": "http://localhost:9500", "current": {"text": "http://localhost:9500", "value": "http://localhost:9500"}},
    {"name": "LIMIT", "label": "History Limit", "type": "textbox", "query": "50", "current": {"text": "50", "value": "50"}}
  ]},
  "panels": [
    {"type": "table", "title": "Latest Feature Shift", "id": 1, "datasource": "${DS_INFINITY}",
      "targets": [{"datasource": "${DS_INFINITY}", "type": "json", "url": "${G6_API_BASE}/api/ml/ensemble/feature_shift/latest", "parser": "backend", "format": "table", "transform": "json", "root_selector": "features", "columns": []}],
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": [
        {"matcher": {"id": "byName", "options": "psi"}, "properties": [{"id": "unit", "value": "none"}, {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": 0.0}, {"color": "yellow", "value": 0.1}, {"color": "orange", "value": 0.25}, {"color": "red", "value": 0.5}]}}]},
        {"matcher": {"id": "byName", "options": "ks"}, "properties": [{"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": 0.0}, {"color": "yellow", "value": 0.1}, {"color": "orange", "value": 0.2}, {"color": "red", "value": 0.3}]}}]}
      ]},
      "transformations": [{"id": "organize", "options": {"renameByName": {"feature": "Feature", "psi": "PSI", "ks": "KS", "sample_size": "Samples"}}}]
    },
    {"type": "timeseries", "title": "PSI History (Max per run)", "id": 2, "datasource": "${DS_INFINITY}",
      "targets": [{"datasource": "${DS_INFINITY}", "type": "json", "url": "${G6_API_BASE}/api/ml/ensemble/feature_shift/history?limit=${LIMIT}", "parser": "backend", "format": "table", "transform": "json", "root_selector": "$", "columns": []}],
      "fieldConfig": {"defaults": {"unit": "none", "custom": {"drawStyle": "line", "lineWidth": 2, "showPoints": "never", "spanNulls": true}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}},
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"features": false}}},
        {"id": "extractFields", "options": {"sourceField": "features", "format": "json"}},
        {"id": "organize", "options": {"renameByName": {"psi": "psi", "ks": "ks", "feature": "feature"}}}
      ],
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 10}
    },
    {"type": "stat", "title": "Active Shift Alerts", "id": 3,
      "datasource": {"type": "prometheus", "uid": "PROMETHEUS_DS_UID"},
      "targets": [
        {"expr": "sum(ALERTS{alertstate=\"firing\", alertname=~\"Feature(PSIHigh|KSHigh).+\"})", "legendFormat": "active_shift_alerts", "instant": true}
      ],
      "options": {"reduceOptions": {"values": false, "calcs": ["last"]}, "orientation": "auto", "textMode": "value", "colorMode": "value", "graphMode": "none"},
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 22}
    },
    {"type": "table", "title": "Firing Shift Alerts (PSI/KS)", "id": 4,
      "datasource": {"type": "prometheus", "uid": "PROMETHEUS_DS_UID"},
      "targets": [
        {"expr": "sum(ALERTS{alertstate=\"firing\", alertname=~\"Feature(PSIHigh|KSHigh).+\"}) by (alertname,severity,index,feature)", "legendFormat": "{{alertname}}", "instant": true}
      ],
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": []},
      "transformations": [
        {"id": "organize", "options": {"renameByName": {"Value": "active", "alertname": "alert", "index": "index", "feature": "feature", "severity": "severity"}}}
      ],
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 28}
    },
    {"type": "table", "title": "Combined Severity by Index", "id": 5,
      "datasource": {"type": "prometheus", "uid": "PROMETHEUS_DS_UID"},
      "targets": [
        {"expr": "2 * clamp_max(max by (index) ((g6_feature_psi > 0.5) bool + (g6_feature_ks > 0.3) bool), 1) + (1 - clamp_max(max by (index) ((g6_feature_psi > 0.5) bool + (g6_feature_ks > 0.3) bool), 1)) * clamp_max(max by (index) ((g6_feature_psi > 0.25) bool + (g6_feature_ks > 0.2) bool), 1)", "legendFormat": "severity", "instant": true}
      ],
      "options": {"showHeader": true},
      "fieldConfig": {"defaults": {"unit": "none"}, "overrides": [
        {"matcher": {"id": "byName", "options": "Value"}, "properties": [
          {"id": "displayName", "value": "severity"},
          {"id": "thresholds", "value": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 2}]}}
        ]},
        {"matcher": {"id": "byName", "options": "severity"}, "properties": [
          {"id": "mappings", "value": [
            {"type": 1, "options": {"match": "0", "result": {"text": "OK", "color": "green"}}},
            {"type": 1, "options": {"match": "1", "result": {"text": "WARN", "color": "yellow"}}},
            {"type": 1, "options": {"match": "2", "result": {"text": "CRIT", "color": "red"}}}
          ]}
        ]}
      ]},
      "transformations": [{"id": "organize", "options": {"renameByName": {"Value": "severity"}}}],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 40}
    },
    {"type": "state-timeline", "title": "PSI Heatmap (24h)", "id": 6, "datasource": "${DS_INFINITY}",
      "targets": [{"datasource": "${DS_INFINITY}", "type": "json", "url": "${G6_API_BASE}/api/ml/ensemble/feature_shift/heatmap?metric=psi&limit=2000", "parser": "backend", "format": "table", "transform": "json", "root_selector": "$", "columns": []}],
      "options": {"legend": {"displayMode": "hidden"}},
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.25}, {"color": "red", "value": 0.5}]}, "unit": "none"}, "overrides": []},
      "transformations": [
        {"id": "filterFieldsByName", "options": {"include": ["ts", "feature", "value"]}},
        {"id": "labelsToFields", "options": {"valueLabel": "value", "labels": ["feature"]}}
      ],
      "gridPos": {"h": 12, "w": 24, "x": 0, "y": 50}
    }
  ],
  "annotations": {"list": [
    {
      "name": "Shift Warn Escalation",
      "type": "dashboard",
      "datasource": {"type": "prometheus", "uid": "PROMETHEUS_DS_UID"},
      "enable": true,
      "iconColor": "rgba(237, 129, 40, 1)",
      "expr": "((clamp_max(max by (index) ((g6_feature_psi > 0.25) bool + (g6_feature_ks > 0.2) bool), 1) - clamp_max(max by (index) ((g6_feature_psi > 0.5) bool + (g6_feature_ks > 0.3) bool), 1)) == 1) and on(index) (changes(clamp_max(max by (index) ((g6_feature_psi > 0.25) bool + (g6_feature_ks > 0.2) bool), 1) - clamp_max(max by (index) ((g6_feature_psi > 0.5) bool + (g6_feature_ks > 0.3) bool), 1))[5m]) > 0)",
      "titleFormat": "WARN escalation: {{index}}",
      "tagKeys": "index",
      "textFormat": "PSI/KS crossed warn threshold"
    },
    {
      "name": "Shift Crit Escalation",
      "type": "dashboard",
      "datasource": {"type": "prometheus", "uid": "PROMETHEUS_DS_UID"},
      "enable": true,
      "iconColor": "rgba(245, 54, 54, 1)",
      "expr": "(clamp_max(max by (index) ((g6_feature_psi > 0.5) bool + (g6_feature_ks > 0.3) bool), 1) == 1) and on(index) (changes(clamp_max(max by (index) ((g6_feature_psi > 0.5) bool + (g6_feature_ks > 0.3) bool), 1)[5m]) > 0)",
      "titleFormat": "CRIT escalation: {{index}}",
      "tagKeys": "index",
      "textFormat": "PSI/KS crossed critical threshold"
    }
  ]},
  "time": {"from": "now-24h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m", "1h"]}
}
