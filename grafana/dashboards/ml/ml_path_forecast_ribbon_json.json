{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "yesoreyeram-infinity-datasource",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "9.5.0" },
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.7.0" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "iteration": 1,
  "links": [
    {
      "title": "Zoom last ${horizon}m (align trailing)",
      "url": "/d/${__dashboard.uid}/${__dashboard.slug}?from=now-${horizon}m&to=now&var-pf_align=trailing",
      "targetBlank": false,
      "includeVars": true
    },
    {
      "title": "Zoom next ${horizon}m (align future)",
      "url": "/d/${__dashboard.uid}/${__dashboard.slug}?from=now&to=now%2B${horizon}m&var-pf_align=future",
      "targetBlank": false,
      "includeVars": true
    },
    {
      "title": "Reset: last 2h",
      "url": "/d/${__dashboard.uid}/${__dashboard.slug}?from=now-2h&to=now",
      "targetBlank": false,
      "includeVars": true
    },
    {
      "title": "Reset all to defaults",
      "url": "http://127.0.0.1:9500/api/ml/reset_defaults?uid=${__dashboard.uid}&slug=${__dashboard.slug}&index=${index}&expiry_tag=${expiry_tag}&offset=${offset}&horizon=${horizon}",
      "targetBlank": false,
      "includeVars": false
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "type": "timeseries",
      "title": "ML Path Forecast – Ribbon (JSON)",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 15, "w": 24, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "custom": { "lineWidth": 2, "spanNulls": true, "gradientMode": "hue" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green" } ] }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "q50" }, "properties": [
            { "id": "color", "value": { "fixedColor": "#4477aa", "mode": "fixed" } },
            { "id": "custom.drawStyle", "value": "line" },
            { "id": "custom.fillOpacity", "value": 0 }
          ] },
          { "matcher": { "id": "byName", "options": "q10" }, "properties": [
            { "id": "color", "value": { "fixedColor": "#00aa55", "mode": "fixed" } },
            { "id": "custom.drawStyle", "value": "line" },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "dash": [6, 3] } }
          ] },
          { "matcher": { "id": "byName", "options": "q90" }, "properties": [
            { "id": "color", "value": { "fixedColor": "#8000ff", "mode": "fixed" } },
            { "id": "custom.drawStyle", "value": "line" },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "dash": [6, 3] } }
          ] },
          { "matcher": { "id": "byName", "options": "tp" }, "properties": [
            { "id": "color", "value": { "fixedColor": "#ffcc00", "mode": "fixed" } },
            { "id": "custom.lineWidth", "value": 1 },
            { "id": "custom.fillOpacity", "value": 0 }
          ] },
          { "matcher": { "id": "byFrameRefID", "options": "TP" }, "properties": [
            { "id": "displayName", "value": "tp_live" }
          ] },
          { "matcher": { "id": "byFrameRefID", "options": "TR" }, "properties": [
            { "id": "color", "value": { "fixedColor": "rgba(160,160,160,0.7)", "mode": "fixed" } },
            { "id": "custom.lineWidth", "value": 1 },
            { "id": "custom.fillOpacity", "value": 0 },
            { "id": "custom.lineStyle", "value": { "dash": [2, 4] } }
          ] }
        ]
      },
      "options": { "legend": { "showLegend": true, "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_forecast_json?index=${index}&horizon_minutes=${horizon}&mode=${pf_mode}&window=${pf_window}&k=${pf_k}&bucket_ms=${pf_bucket}&calibrate=${calibrate}&no_cache=true&date_str=${date_str}&now_override_ms=${now_ms}&expiry_tag=${expiry_tag}&offset=${offset}&align=${pf_align}&profile=${profile}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "parser": "backend",
          "format": "table",
          "root_selector": "$",
          "json_options": { "root_is_not_first_line": false, "root": "$" },
           "columns": [
             { "selector": "plot_time", "type": "string" },
             { "selector": "q10", "type": "number" },
             { "selector": "q50", "type": "number" },
             { "selector": "q90", "type": "number" }
           ]
        },
        {
          "refId": "TR",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_forecast_json?index=${index}&horizon_minutes=${horizon}&mode=${pf_mode}&window=${pf_window}&k=${pf_k}&bucket_ms=${pf_bucket}&calibrate=${calibrate}&no_cache=true&date_str=${date_str}&now_override_ms=${now_ms}&expiry_tag=${expiry_tag}&offset=${offset}&align=trailing&profile=${profile}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "parser": "backend",
          "format": "table",
          "root_selector": "$",
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [
            { "selector": "plot_time", "type": "string" },
            { "selector": "q10", "type": "number" },
            { "selector": "q50", "type": "number" },
            { "selector": "q90", "type": "number" }
          ]
        },
        {
          "refId": "TP",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/tp_series?index=${index}&expiry_tag=${expiry_tag}&offset=${offset}&window_minutes=${hist_minutes}&bucket_ms=${pf_bucket}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "parser": "backend",
          "format": "table",
          "root_selector": "$",
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [
            { "selector": "plot_time", "type": "string" },
            { "selector": "tp", "type": "number" }
          ]
        }
      ],
      "transformations": [
        { "id": "convertFieldType", "options": { "conversions": [ { "targetField": "plot_time", "destinationType": "time" } ] } },
        { "id": "prepareTimeSeries", "options": { "timeField": "plot_time", "valueFields": ["q10","q50","q90","tp"], "labelFields": [] } }
      ]
    },
    {
      "type": "table",
      "title": "Generation meta (JSON)",
      "description": "Generation metadata for the current path forecast: Forecaster mode (hybrid/retrieval), Neighbors (k) used for retrieval, Intraday window in minutes, and the current calibration Band scale applied to quantile bands. Timestamp reflects when the ribbon was generated.",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 15 },
      "targets": [
        {
          "refId": "B",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_forecast_meta?index=${index}&horizon_minutes=${horizon}&mode=${pf_mode}&window=${pf_window}&k=${pf_k}&date_str=${date_str}&now_override_ms=${now_ms}&expiry_tag=${expiry_tag}&offset=${offset}&profile=${profile}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [
            { "selector": "last_tp", "text": "Last live TP (straddle)", "type": "number" },
            { "selector": "gen_iso", "text": "Generated at (ISO)", "type": "string" },
            { "selector": "mode", "text": "Forecaster mode", "type": "string" },
            { "selector": "k", "text": "Neighbors (k)", "type": "number" },
            { "selector": "window", "text": "Window (min)", "type": "number" },
            { "selector": "band_scale", "text": "Band scale", "type": "number" },
            { "selector": "requested_day", "text": "Requested day", "type": "string" },
            { "selector": "source_day", "text": "Source day", "type": "string" },
            { "selector": "source_status", "text": "Source status", "type": "string" },
            { "selector": "profile", "text": "Profile", "type": "string" },
            { "selector": "profile_force_mode", "text": "Force mode", "type": "string" }
          ]
        }
      ],
      "options": { "showHeader": true },
      "fieldConfig": {
        "defaults": { },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Last live TP (straddle)" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }, { "id": "custom.width", "value": 150 } ] },
          { "matcher": { "id": "byName", "options": "Generated at (ISO)" }, "properties": [ { "id": "custom.width", "value": 220 } ] },
          { "matcher": { "id": "byName", "options": "Forecaster mode" }, "properties": [ { "id": "custom.width", "value": 140 } ] },
          { "matcher": { "id": "byName", "options": "Neighbors (k)" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }, { "id": "custom.align", "value": "center" }, { "id": "custom.width", "value": 120 } ] },
          { "matcher": { "id": "byName", "options": "Window (min)" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 0 }, { "id": "custom.align", "value": "center" }, { "id": "custom.width", "value": 130 } ] },
          { "matcher": { "id": "byName", "options": "Band scale" }, "properties": [ { "id": "unit", "value": "short" }, { "id": "decimals", "value": 2 }, { "id": "custom.align", "value": "center" }, { "id": "custom.width", "value": 120 } ] },
          { "matcher": { "id": "byName", "options": "Requested day" }, "properties": [ { "id": "custom.width", "value": 140 } ] },
          { "matcher": { "id": "byName", "options": "Source day" }, "properties": [ { "id": "custom.width", "value": 140 } ] },
          { "matcher": { "id": "byName", "options": "Source status" }, "properties": [ { "id": "custom.width", "value": 120 }, { "id": "mappings", "value": [ { "type": "value", "options": { "live": { "text": "live", "color": "green" }, "backfill": { "text": "backfill", "color": "orange" } } } ] }, { "id": "custom.align", "value": "center" } ] }
        ]
      }
    },
    {
      "type": "stat",
      "title": "Data status",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 27 },
      "targets": [
        {
          "refId": "DS",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_forecast_meta?index=${index}&horizon_minutes=${horizon}&mode=${pf_mode}&window=${pf_window}&k=${pf_k}&date_str=${date_str}&now_override_ms=${now_ms}&expiry_tag=${expiry_tag}&offset=${offset}&profile=${profile}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "source_status", "text": "status", "type": "string" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "live": { "text": "live", "color": "green" }, "backfill": { "text": "backfill", "color": "orange" } } },
            { "type": "special", "options": { "match": "null", "result": { "text": "—", "color": "gray" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Calibrated coverage @${horizon}m",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 5, "w": 5, "x": 0, "y": 21 },
      "targets": [
        {
          "refId": "C",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_stats?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&date_str=${date_str}&variant=calibrated&expiry_tag=${expiry_tag}&offset=${offset}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "coverage_p10_p90", "text": "coverage", "type": "number" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
  "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "mappings": [ { "type": "special", "options": { "match": "null", "result": { "text": "—" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "orange", "value": 0.65 }, { "color": "green", "value": 0.75 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Raw coverage @${horizon}m",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 5, "w": 5, "x": 5, "y": 21 },
      "targets": [
        {
          "refId": "D",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_stats?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&date_str=${date_str}&variant=raw&expiry_tag=${expiry_tag}&offset=${offset}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "coverage_p10_p90", "text": "coverage_raw", "type": "number" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
  "fieldConfig": { "defaults": { "unit": "percentunit", "decimals": 2, "mappings": [ { "type": "special", "options": { "match": "null", "result": { "text": "—" } } } ], "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": 0 }, { "color": "orange", "value": 0.65 }, { "color": "green", "value": 0.75 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Avg band width @${horizon}m",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 5, "w": 5, "x": 10, "y": 21 },
      "targets": [
        {
          "refId": "E",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_stats?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&date_str=${date_str}&variant=calibrated&expiry_tag=${expiry_tag}&offset=${offset}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "band_width_mean", "text": "bandw", "type": "number" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
  "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "mappings": [ { "type": "special", "options": { "match": "null", "result": { "text": "—" } } } ] }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Samples @${horizon}m",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 5, "w": 4, "x": 15, "y": 21 },
      "targets": [
        {
          "refId": "F",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_stats?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&date_str=${date_str}&variant=calibrated&expiry_tag=${expiry_tag}&offset=${offset}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "samples", "text": "samples", "type": "number" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
  "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "mappings": [ { "type": "special", "options": { "match": "null", "result": { "text": "—" } } } ] }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Band scale (current)",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 5, "w": 5, "x": 19, "y": 21 },
      "targets": [
        {
          "refId": "G",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_forecast_meta?index=${index}&horizon_minutes=${horizon}&date_str=${date_str}&now_override_ms=${now_ms}&expiry_tag=${expiry_tag}&offset=0&profile=${profile}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "band_scale", "text": "band_scale", "type": "number" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "horizontal", "textMode": "value", "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
  "fieldConfig": { "defaults": { "unit": "short", "decimals": 2, "mappings": [ { "type": "special", "options": { "match": "null", "result": { "text": "—" } } } ] }, "overrides": [] }
    },
    {
      "type": "text",
      "title": "Notes",
      "gridPos": { "h": 4, "w": 18, "x": 0, "y": 33 },
      "options": {
        "mode": "markdown",
        "content": "- Coverage stats may be null early until bands archive fills for the day.\n- Calibrated uses current band_scale; Raw approximates pre-calibration by reverse-scaling around q50.\n- Variables date_str and now_override_ms keep Meta/Ribbon/Stats aligned for replay."
      }
    },
    {
      "type": "text",
      "title": "Manual: Calibrate now",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 33 },
      "options": {
        "mode": "markdown",
        "content": "**Caution**: Triggers calibration immediately using current data.\n\n[Run calibrate now](${base_url}/api/ml/path_calibrate_now?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&target=${cal_target}&confirm=true&view=html)\n\nReturns band_scale, coverage, and samples."
      }
    },
    {
      "type": "text",
      "title": "Quick links",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 37 },
      "options": {
        "mode": "markdown",
        "content": "- [Health](${base_url}/health)  |  [Routes](${base_url}/api/routes)  |  [OpenAPI](${base_url}/openapi.json)  |  [Docs UI](${base_url}/docs)  |  [Resolve live path](${base_url}/api/ml/_debug/find_live_path?index=${index}&expiry_tag=${expiry_tag}&offset=0&date_str=${date_str})  |  [User Guide](/d/${__dashboard.uid}/${__dashboard.slug}?viewPanel=1999)"
      }
    },
    {
      "type": "stat",
      "title": "Advisor summary",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 37 },
      "targets": [
        {
          "refId": "SUM",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_advisor?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&date_str=${date_str}&gap_warn=${gap_warn}&gap_crit=${gap_crit}&min_samples_warn=${min_samples_warn}&min_samples_crit=${min_samples_crit}&expiry_tag=${expiry_tag}&offset=${offset}",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$.summary" },
          "columns": [ { "selector": "level", "text": "level", "type": "string" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "ok": { "text": "ok", "color": "green" }, "warn": { "text": "warn", "color": "orange" }, "crit": { "text": "crit", "color": "red" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "API routes (count)",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 37 },
      "targets": [
        {
          "refId": "RC",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/routes",
          "url_options": { "method": "GET", "data": "", "params": [], "headers": [] },
          "json_options": { "root_is_not_first_line": false, "root": "$" },
          "columns": [ { "selector": "count", "text": "count", "type": "number" } ]
        }
      ],
      "options": { "reduceOptions": { "calculations": ["lastNotNull"], "values": false }, "orientation": "auto", "textMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Gap vs target (abs)",
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 37 },
      "targets": [
        {
          "refId": "GAP",
          "type": "json",
          "source": "url",
          "url": "${base_url}/api/ml/path_advisor?index=${index}&horizon=${horizon}&window_minutes=${diag_window}&date_str=${date_str}&gap_warn=${gap_warn}&gap_crit=${gap_crit}&expiry_tag=${expiry_tag}&offset=${offset}",
