{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "Infinity datasource (HTTP / JSON).",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0" },
    { "type": "panel", "id": "table", "name": "Table" },
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.6.0" }
  ],
  "title": "Regime Drift Threshold Manifest",
  "uid": "regime-threshold-manifest",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "type": "stat",
      "title": "Promotion Status",
      "id": 1,
      "datasource": "${DS_INFINITY}",
      "targets": [
        {
          "datasource": "${DS_INFINITY}",
          "type": "json",
          "url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1",
          "parser": "backend",
          "format": "table",
          "transform": "json",
          "root_selector": "$",
          "columns": []
        }
      ],
      "maxDataPoints": 1,
      "options": {
        "reduceOptions": { "values": false, "calcs": ["last"], "fields": "" },
        "orientation": "auto",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": { "include": ["reason"] }
        }
      ]
    },
    {
      "type": "table",
      "title": "Relative Shifts (%)",
      "id": 4,
      "datasource": "${DS_INFINITY}",
      "targets": [
        {
          "datasource": "${DS_INFINITY}",
          "type": "json",
          "url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1",
          "parser": "backend",
          "format": "table",
          "transform": "json",
          "root_selector": "relative_shifts",
          "columns": []
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": { "unit": "percent" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "key" },
            "properties": [ { "id": "unit", "value": "none" } ]
          },
          {
            "matcher": { "id": "byName", "options": "violation" },
            "properties": [ { "id": "custom.cellOptions", "value": { "type": "color-text" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "relative_shift_pct" },
            "properties": [
              { "id": "unit", "value": "percent" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "percentage",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 5 },
                    { "color": "orange", "value": 10 },
                    { "color": "red", "value": 15 }
                  ]
                }
              },
              { "id": "custom.cellOptions", "value": { "type": "gauge" } }
            ]
          }
        ]
      },
      "transformations": [
        { "id": "organize", "options": { "indexByName": {}, "renameByName": { "key": "metric", "relative_shift_pct": "shift_%" } } }
      ]
    },
    {
      "type": "table",
      "title": "Current Thresholds",
      "id": 2,
      "datasource": "${DS_INFINITY}",
      "targets": [
        {
          "datasource": "${DS_INFINITY}",
          "type": "json",
          "url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1",
          "parser": "backend",
          "format": "table",
          "transform": "json",
          "root_selector": "thresholds",
          "columns": []
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": { "unit": "none" },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Stability & Percentiles",
      "id": 3,
      "datasource": "${DS_INFINITY}",
      "targets": [
        {
          "datasource": "${DS_INFINITY}",
          "type": "json",
          "url": "/api/ml/ensemble/regime/threshold_manifest?include_full=1",
          "parser": "backend",
          "format": "table",
          "transform": "json",
          "root_selector": "$",
          "columns": []
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "thresholds": true } } }
      ],
      "options": { "showHeader": true },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    }
  ],
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m", "15m", "1h"] }
}
