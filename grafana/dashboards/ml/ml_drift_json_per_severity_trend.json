{
  "uid": "ml_drift_json_per_severity_trend",
  "title": "ML Drift Severity Trend (JSON API)",
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "index",
        "type": "custom",
        "query": "NIFTY,BANKNIFTY",
        "current": { "text": "NIFTY", "value": "NIFTY", "selected": true }
      },
      {
        "name": "days",
        "type": "custom",
        "query": "7,14,30",
        "current": { "text": "14", "value": "14", "selected": true }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Critical ({{$index}})",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
          "type": "json",
          "source": "url",
          "url": "http://localhost:9500/api/ml/drift/daily_reports/trend?days=${days}",
          "json_options": { "root_is_not_array": true, "root_selector": "per_index_severity_series.${index}.critical" },
          "columns": [
            { "selector": "generated_at", "text": "Time", "type": "time" },
            { "selector": "value", "text": "Critical", "type": "number" }
          ]
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Actionable ({{$index}})",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "B",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
          "type": "json",
          "source": "url",
          "url": "http://localhost:9500/api/ml/drift/daily_reports/trend?days=${days}",
          "json_options": { "root_is_not_array": true, "root_selector": "per_index_severity_series.${index}.actionable" },
          "columns": [
            { "selector": "generated_at", "text": "Time", "type": "time" },
            { "selector": "value", "text": "Actionable", "type": "number" }
          ]
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Watch ({{$index}})",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "targets": [
        {
          "refId": "C",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "${DS_INFINITY}" },
          "type": "json",
          "source": "url",
          "url": "http://localhost:9500/api/ml/drift/daily_reports/trend?days=${days}",
          "json_options": { "root_is_not_array": true, "root_selector": "per_index_severity_series.${index}.watch" },
          "columns": [
            { "selector": "generated_at", "text": "Time", "type": "time" },
            { "selector": "value", "text": "Watch", "type": "number" }
          ]
        }
      ]
    }
  ],
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ]
}
