{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://g6.local/schemas/provenance.schema.json",
  "title": "G6 Provenance Manifest",
  "type": "object",
  "required": [
    "version",
    "config_index",
    "config_hash",
    "signing",
    "timestamp_utc",
    "actor",
    "artifacts"
  ],
  "properties": {
    "version": { "type": "string" },
    "config_index": { "type": "string", "minLength": 1 },
    "config_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "signing": {
      "type": "object",
      "required": ["algorithm", "key_id"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["HMAC-SHA256"] },
        "key_id": { "type": "string" }
      }
    },
    "timestamp_utc": { "type": "string", "format": "date-time" },
    "actor": {
      "type": "object",
      "required": ["name", "email"],
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "hash"],
        "properties": {
          "name": { "type": "string" },
          "version": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "hash"],
        "properties": {
          "path": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "previous_hash": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "notes": { "type": ["string", "null"] },
    "signature": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
  }
}