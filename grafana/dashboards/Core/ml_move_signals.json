{
  "title": "Move Signals (TP)",
  "uid": "ml-move-signals",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-3h", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Move Probability",
      "id": 1,
      "targets": [
        {
          "expr": "g6_ml_move_probability{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "move_prob ($index,$horizon)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.6 },
              { "color": "red", "value": 0.8 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Conditional Magnitude (on predicted moves)",
      "id": 2,
      "targets": [
        {
          "expr": "g6_ml_move_conditional_magnitude{index=\"$index\",horizon=\"$horizon\"}",
          "legendFormat": "cond_mag ($index,$horizon)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] }
    },
    {
      "type": "table",
      "title": "Move Stats (last 180m)",
      "id": 3,
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "INFINITY" },
          "type": "csv",
          "source": "url",
          "format": "table",
          "url": "/api/ml/move_stats?index=$index&horizon=$horizon&window_minutes=180&prob_threshold=0.6",
          "parser": "backend",
          "url_options": { "method": "GET" },
          "filters": []
        }
      ],
      "options": { "showHeader": true },
      "transformations": [],
      "fieldConfig": {
        "defaults": { "unit": "none", "mappings": [] },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "avg_probability" },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "orange", "value": 0.5 },
                    { "color": "green", "value": 0.7 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "high_prob_share" },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "orange", "value": 0.3 },
                    { "color": "red", "value": 0.6 }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "index",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(g6_ml_move_probability, index)",
        "refresh": 2
      },
      {
        "name": "horizon",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(g6_ml_move_probability, horizon)",
        "refresh": 2
      }
    ]
  }
}
