{
  "uid": "g6-live-csv-infinity",
  "title": "G6 Overlays â€“ Live from CSV (Infinity)",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "15s",
  "tags": ["g6", "overlay", "infinity", "csv"],
  "g6_meta": {"families": ["overlay"], "description": "Directly projects today's CSV via Infinity (tp, avg_tp)", "explorer": true},
  "time": {"from": "now-12h", "to": "now+6h"},
  "timezone": "Asia/Kolkata",
  "templating": {
    "list": [
      {"name": "offset", "type": "custom", "query": "0,+100,-100,+200,-200", "current": {"text": "0", "value": "0"}, "label": "Offset"},
      {"name": "expiry_ns", "type": "custom", "query": "this_week,next_week,this_month,next_month", "current": {"text": "this_week", "value": "this_week"}, "label": "Expiry (NIFTY/SENSEX)"},
      {"name": "expiry_bf", "type": "custom", "query": "this_month,next_month", "current": {"text": "this_month", "value": "this_month"}, "label": "Expiry (BANK/FIN)"},
  {"name": "show_avg", "type": "custom", "query": "1,0", "current": {"text": "1", "value": "1"}, "label": "Show avg_tp"},
  {"name": "show_op",  "type": "custom", "query": "1,0", "current": {"text": "0", "value": "0"}, "label": "Show CE + PE"}
    ]
  },
  "panels": [
    {
      "type": "timeseries",
  "title": "NIFTY | $expiry_ns | $offset â€“ CSV (tp + Index Price)",
      "gridPos": {"h": 14, "w": 24, "x": 0, "y": 0},
      "options": {"legend": {"showLegend": true, "placement": "bottom"}},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": [
        {"matcher": {"id": "byName", "options": "Index Price"},
         "properties": [
           {"id": "custom.axisPlacement", "value": "hidden"},
           {"id": "unit", "value": "none"},
           {"id": "color", "value": {"mode": "palette-classic"}}
         ]}
        ,{"matcher": {"id": "byRegex", "options": ".*OI$"}, "properties": [
            {"id": "custom.axisPlacement", "value": "right"},
            {"id": "unit", "value": "short"},
            {"id": "custom.scaleDistribution", "value": {"type": "linear"}}
        ]}
        ,{"matcher": {"id": "byRegex", "options": ".*vol$"}, "properties": [
            {"id": "custom.axisPlacement", "value": "right"},
            {"id": "unit", "value": "short"}
        ]}
      ]},
      "targets": [
        {"refId": "A", "queryType": "json", "type": "json", "source": "url", "format": "table", "method": "GET",
         "url_options": {"method": "GET", "params": [
           {"key": "limit", "value": "2000"},
           {"key": "from_ms", "value": "${__from}"},
           {"key": "to_ms", "value": "${__to}"},
           {"key": "cb", "value": "${__unixEpochMs}"}
         ]}, "datasource": {"type": "yesoreyeram-infinity-datasource", "uid": "INFINITY"},
         "url": "http://127.0.0.1:9510/api/live_csv?index=NIFTY&expiry_tag=$expiry_ns&offset=$offset&include_oi=1&include_volume=1&include_index=1",
         "json_options": {"root_is_array": true},
         "columns": [
           {"selector": "time_str", "text": "time", "type": "timestamp"},
           {"selector": "tp", "text": "tp", "type": "number"}
