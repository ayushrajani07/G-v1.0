      "fieldConfig": {"defaults": {"unit": "percent", "max": 1, "min": 0, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red"}, {"color": "yellow", "value": 0.5}, {"color": "green", "value": 0.7}]}}, "overrides": []},
