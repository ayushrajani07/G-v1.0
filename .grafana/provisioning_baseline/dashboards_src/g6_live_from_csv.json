        "options": [
          {
            "selected": true,
            "text": "127.0.0.1:9500 (default)",
            "value": "127.0.0.1:9500"
          },
          {
            "selected": false,
            "text": "127.0.0.1:9510 (alt)",
            "value": "127.0.0.1:9510"
