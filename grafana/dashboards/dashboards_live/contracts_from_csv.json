{
  "uid": "g6-contracts-csv",
  "title": "G6 Contracts \u2013 Live from CSV (Infinity)",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "15s",
  "tags": [
    "g6",
    "contracts",
    "infinity",
    "csv"
  ],
  "g6_meta": {
    "families": [
      "overlay"
    ],
    "description": "Contracts view from today's CSV via Infinity (index, PCR, volumes, OI)"
  },
  "time": {
    "from": "now-12h",
    "to": "now+6h"
  },
  "timezone": "Asia/Kolkata",
  "templating": {
    "list": [
      {
        "name": "offset",
        "type": "custom",
        "query": "0,+100,-100,+200,-200",
        "current": {
          "text": "0",
          "value": "0"
        },
        "label": "Offset"
      },
      {
        "name": "expiry_ns",
        "type": "custom",
        "query": "this_week,next_week,this_month,next_month",
        "current": {
          "text": "this_week",
          "value": "this_week"
        },
        "label": "Expiry (NIFTY/SENSEX)"
      },
      {
        "name": "expiry_bf",
        "type": "custom",
        "query": "this_month,next_month",
        "current": {
          "text": "this_month",
          "value": "this_month"
        },
        "label": "Expiry (BANK/FIN)"
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "INFINITY"
      },
      "title": "NIFTY | $expiry_ns | $offset \u2013 Contracts",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisPlacement": "auto",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "lineInterpolation": "smooth",
            "gradientMode": "hue",
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ce_oi$|.*ce_oi .*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Call Open Interest"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Open Interest"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "solid"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pe_oi$|.*pe_oi .*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Put Open Interest"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Open Interest"
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "solid"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*ce_vol$|.*ce_vol .*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Call Volume"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "custom.axisLabel",
                "value": "Volume"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pe_vol$|.*pe_vol .*"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Put Volume"
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              },
              {
                "id": "custom.axisLabel",
                "value": "Volume"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*[Ii]ndex.*|.*price"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Index Price"
              },
              {
                "id": "custom.axisPlacement",
                "value": "hidden"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*pcr$|.*PCR"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "PCR"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "PCR"
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "color",
                "value": {"mode": "fixed", "fixedColor": "yellow"}
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "IDX",
          "queryType": "json",
          "type": "json",
          "source": "url",
          "format": "table",
          "method": "GET",
          "parser": "backend",
          "url_options": {
            "method": "GET",
            "params": [
              {
                "key": "limit",
                "value": "2000"
              },
              {
                "key": "include_index",
                "value": "1"
              },
              {
                "key": "include_analytics",
                "value": "1"
              },
              {
                "key": "from_ms",
                "value": "${__from}"
              },
              {
                "key": "to_ms",
                "value": "${__to}"
              },
              {
                "key": "cb",
                "value": "${__unixEpochMs}"
              }
            ]
          },
          "datasource": {
            "type": "yesoreyeram-infinity-datasource",
            "uid": "INFINITY"
          },
          "url": "http://127.0.0.1:9510/api/live_csv?index=NIFTY&expiry_tag=$expiry_ns&offset=$offset&include_index=1&include_oi=1&include_volume=1&include_pcr=1",
          "json_options": {
            "root_is_array": true
          },
          "columns": [
            {
              "selector": "time_str",
              "text": "time",
              "type": "timestamp"
            },
            {
              "selector": "index_price",
              "text": "Index Price",
              "type": "number"
            },
            {
              "selector": "pcr",
              "text": "pcr",
              "type": "number"
            },
            {
              "selector": "ce_vol",
