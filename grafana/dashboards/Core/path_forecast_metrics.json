        {"expr": "histogram_quantile(0.90, sum by (le) (rate(pf_retrieval_latency_ms_bucket[5m])))", "legendFormat": "p90", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(pf_retrieval_latency_ms_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Retrieval Latency Quantiles (5m rate)",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "palette-classic"}}, "overrides": []},
