{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.5.0" },
    { "type": "panel", "id": "graph", "name": "Graph", "version": "9.5.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "2.0.0" }
  ],
  "title": "G6 Streaming Metrics",
  "tags": ["g6", "streaming", "metrics"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "datasource",
        "name": "DS_PROM",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "graph",
      "title": "Live MAE",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "g6_live_mae",
          "legendFormat": "MAE",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null"
    },
    {
      "id": 2,
      "type": "graph",
      "title": "Live MAE Alerts (total)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "increase(g6_live_mae_alerts_total[15m])",
          "legendFormat": "Alerts (15m)",
          "refId": "A"
        }
      ],
      "lines": true,
      "linewidth": 2,
      "nullPointMode": "null"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Current MAE",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 9 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "expr": "g6_live_mae", "refId": "A" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Alerts (sum)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROM}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 9 },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [ { "expr": "g6_live_mae_alerts_total", "refId": "A" } ]
    }
  ]
}
