{
  "__inputs": [
    {
      "name": "DS_INFINITY",
      "label": "Infinity",
      "description": "Infinity datasource (HTTP / JSON).",
      "type": "datasource",
      "pluginId": "yesoreyeram-infinity-datasource",
      "pluginName": "Infinity"
    }
  ],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "9.0.0"},
    {"type": "panel", "id": "table", "name": "Table"},
    {"type": "panel", "id": "timeseries", "name": "Time series"},
    {"type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "2.6.0"}
  ],
  "title": "Forecast TTL Impact Study",
  "uid": "ttl-impact-study",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "panels": [
    {
      "type": "table",
      "title": "Scenario Summary",
      "id": 1,
      "datasource": "${DS_INFINITY}",
      "targets": [
        {
          "datasource": "${DS_INFINITY}",
            "type": "json",
            "url": "/api/ml/ensemble/ttl_study",
            "parser": "backend",
            "format": "table",
            "transform": "json",
            "root_selector": "scenarios",
            "columns": []
        }
      ],
      "options": {"showHeader": true},
      "fieldConfig": {
        "defaults": {"unit": "none"},
        "overrides": [
          {"matcher": {"id": "byName", "options": "hit_ratio"}, "properties": [{"id": "unit", "value": "percent"}]},
          {"matcher": {"id": "byName", "options": "latency_ms_p95"}, "properties": [{"id": "unit", "value": "ms"}]},
          {"matcher": {"id": "byName", "options": "latency_ms_p50"}, "properties": [{"id": "unit", "value": "ms"}]}
        ]
      },
      "transformations": [
        {"id": "organize", "options": {"renameByName": {"latency_ms_p95": "p95_ms", "latency_ms_p50": "p50_ms"}}}
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency vs Baseline Delta",
      "id": 2,
      "datasource": "${DS_INFINITY}",
      "targets": [
        {
          "datasource": "${DS_INFINITY}",
          "type": "json",
          "url": "/api/ml/ensemble/ttl_study",
          "parser": "backend",
          "format": "table",
          "transform": "json",
          "root_selector": "deltas_vs_baseline",
          "columns": []
        }
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "options": {"legend": {"displayMode": "list"}, "tooltip": {"mode": "single"}}
    }
  ],
  "templating": {"list": []},
  "annotations": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {"refresh_intervals": ["30s", "1m", "5m", "15m"]}
}
