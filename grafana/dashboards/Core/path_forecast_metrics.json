      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(pf_composite_latency_ms_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.90, sum by (le) (rate(pf_composite_latency_ms_bucket[5m])))", "legendFormat": "p90", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(pf_composite_latency_ms_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Composite Latency Quantiles (5m rate)",
