{
  "id": null,
  "uid": "g6-phase13",
  "title": "G6 Phase 13 Observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "index",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(g6_ml_api_latency_anomaly, index)",
        "refresh": 2,
        "hide": 0
      },
      {
        "name": "horizon",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(g6_ml_api_latency_anomaly, horizon)",
        "refresh": 2,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Latency Anomaly (z-score)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "g6_ml_api_latency_anomaly{index=\"$index\", horizon=\"$horizon\"}",
          "legendFormat": "{{index}} {{horizon}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Feature Completeness Ratio",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": { "from": 0, "to": 0.5 },
              "text": "Low"
            },
            {
              "type": "range",
              "options": { "from": 0.5, "to": 0.8 },
              "text": "Degraded"
            },
            {
              "type": "range",
              "options": { "from": 0.8, "to": 1 },
              "text": "Healthy"
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "g6_ml_feature_completeness_ratio{index=\"$index\", horizon=\"$horizon\"}",
          "legendFormat": "{{index}} {{horizon}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tail Burn Acceleration",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 2 },
              { "color": "red", "value": 3 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "g6_ml_tail_burn_accel{index=\"$index\", horizon=\"$horizon\"}",
          "legendFormat": "{{index}} {{horizon}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Weights Divergence",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "mappings": [
            {
              "type": "range",
              "options": { "from": 0, "to": 0.1 },
              "text": "Stable"
            },
            {
              "type": "range",
              "options": { "from": 0.1, "to": 0.2 },
              "text": "Shifting"
            },
            {
              "type": "range",
              "options": { "from": 0.2, "to": 1 },
              "text": "Diverging"
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "g6_ml_weights_divergence{index=\"$index\", horizon=\"$horizon\"}",
          "legendFormat": "{{index}} {{horizon}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Per-Index Overview",
      "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "repeat": "index",
      "collapsed": false,
      "panels": [
        {
          "type": "timeseries",
          "title": "Latency Anomaly ($index)",
          "gridPos": { "x": 0, "y": 17, "w": 12, "h": 6 },
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "g6_ml_api_latency_anomaly{index=\"$index\", horizon=\"$horizon\"}",
              "legendFormat": "{{horizon}}",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Completeness ($index)",
          "gridPos": { "x": 12, "y": 17, "w": 12, "h": 6 },
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "g6_ml_feature_completeness_ratio{index=\"$index\", horizon=\"$horizon\"}",
              "legendFormat": "{{horizon}}",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Tail-Burn ($index)",
          "gridPos": { "x": 0, "y": 23, "w": 12, "h": 6 },
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "g6_ml_tail_burn_accel{index=\"$index\", horizon=\"$horizon\"}",
              "legendFormat": "{{horizon}}",
              "refId": "A"
            }
          ]
        },
        {
          "type": "timeseries",
          "title": "Weights Div ($index)",
          "gridPos": { "x": 12, "y": 23, "w": 12, "h": 6 },
          "datasource": "Prometheus",
          "targets": [
            {
              "expr": "g6_ml_weights_divergence{index=\"$index\", horizon=\"$horizon\"}",
              "legendFormat": "{{horizon}}",
              "refId": "A"
            }
          ]
        }
      ]
    }
    ,
    {
      "type": "table",
      "title": "Current Status (Index + Horizon)",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 8 },
      "datasource": "Prometheus",
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "groupBy", "options": { "fields": {
          "Labels index": { "aggregations": ["lastNotNull"], "operation": "groupBy" },
          "Labels horizon": { "aggregations": ["lastNotNull"], "operation": "groupBy" }
        } } }
      ],
      "targets": [
        {
          "expr": "g6_ml_api_latency_anomaly",
          "legendFormat": "latency_anomaly",
          "refId": "A",
          "instant": true
        },
        {
          "expr": "g6_ml_feature_completeness_ratio",
          "legendFormat": "feature_completeness",
          "refId": "B",
          "instant": true
        },
        {
          "expr": "g6_ml_tail_burn_accel",
          "legendFormat": "tail_burn_accel",
          "refId": "C",
          "instant": true
        },
        {
          "expr": "g6_ml_weights_divergence",
          "legendFormat": "weights_divergence",
          "refId": "D",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ]
}