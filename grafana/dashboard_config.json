    }
  },
  
  "folders": {
    "Core": {
      "description": "Core system health and advisor dashboards",
      "priority": 1
    },
    "Analytics": {
      "description": "Analytics and percentage change visualizations",
      "priority": 2
    },
    "Forecasting": {
      "description": "Path forecasting and prediction dashboards",
      "priority": 3
    },
    "ML": {
      "description": "Machine learning model dashboards",
      "priority": 4
    },
    "Generated": {
      "description": "Auto-generated system dashboards (created by gen_dashboards_modular.py from metrics_spec.yaml)",
      "priority": 5,
      "note": "DO NOT edit these JSON files manually - modify metrics spec and regenerate instead"
    },
    "Performance": {
      "description": "System performance and orchestrator metrics",
      "priority": 6
    },
    "Miscellaneous": {
      "description": "Experimental and test dashboards",
      "priority": 98
    },
    "Snippets": {
      "description": "Dashboard code snippets and examples",
      "priority": 99
    }
  },
  
  "settings": {
    "base_path": "c:/Users/Asus/Desktop/g6_reorganized/grafana/dashboards",
    "provisioning_path": "c:/Users/Asus/Desktop/g6_reorganized/provisioning/dashboards",
    "archive_path": "c:/Users/Asus/Desktop/g6_reorganized/grafana/dashboards/.archive",
    "auto_create_folders": true,
    "editable": true,
    "disable_deletion": false
  },
  
  "archived": {
    "_comment": "Dashboards that have been archived (moved to .archive directory)",
    "_note": "Archived dashboards are preserved but not loaded by Grafana"
  }
}
